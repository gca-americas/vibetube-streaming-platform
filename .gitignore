# Dependencies
node_modules/
**/node_modules/

# Python Virtual Environments & Cache
venv/
.venv/
__pycache__/
.pyc

# Local cache directories
.vite/
*.db
backend/uploads/

# Production build output
dist/
dist-ssr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Video assets and transcoder output directories
*.MOV
*.mov
*_transcoded/

# Environment files. Only the .example variants belong in the repo.
.env
.env.*
!.env.example
!**/.env.example

# Local assistant/editor tooling. Kept out of the repository so the history
# reflects the project rather than whatever was used to work on it, and so
# machine-specific paths in those config files never reach a shared branch.
.claude/
CLAUDE.md
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurfrules
.github/copilot-instructions.md
.codeium/
.sourcegraph/
*.ai-session
.specstory/

