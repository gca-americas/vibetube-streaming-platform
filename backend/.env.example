# Required for the admin seeding endpoints. They fail closed when this is
# unset, so leave it configured even locally.
ADMIN_TOKEN=local-admin-token

# Shared secret the transcoder presents on its completion callback.
TRANSCODER_SECRET_TOKEN=local-transcoder-token

# Production only -- unset locally to use SQLite and local disk uploads.
# The "vibeflix" names below are the existing GCP resources. They predate the
# rename to Vibetube and cannot be renamed in place; see deploy.sh.
# DATABASE_URL=postgresql://user:password@/vibeflix?host=/cloudsql/INSTANCE
# RAW_VIDEOS_BUCKET=vibeflix-sandbox-raw-videos
# PUBLIC_STREAMS_BUCKET=vibeflix-sandbox-public-streams
# TRANSCODER_JOB_NAME=transcoder-job
# GCP_PROJECT=vibeflix-sandbox
# GCP_LOCATION=us-central1
# BACKEND_URL=https://vibetube-service-xxxx.run.app
