# Required for the admin seeding endpoints. They fail closed when this is
# unset, so leave it configured even locally.
ADMIN_TOKEN=local-admin-token

# Shared secret the transcoder presents on its completion callback.
TRANSCODER_SECRET_TOKEN=local-transcoder-token

# --- Admin console sign-in --------------------------------------------------
# The /admin console signs in with Google through Firebase. With these unset,
# every /api/admin/* endpoint returns 503 rather than being open -- the admin
# API fails closed.
#
# To work on the console locally, point these at the same Firebase project as
# production. Firebase authorises localhost by default, so no extra setup is
# needed. Read the values with:
#
#   gcloud run services describe vibetube-service --region=us-central1 \
#     --format='value(spec.template.spec.containers[0].env)'
#
# FIREBASE_PROJECT_ID=vibetube-streaming-platform
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=vibetube-streaming-platform.firebaseapp.com

# Addresses granted admin access on first start, comma-separated. Only ever
# adds -- see seed_admin_users in database.py.
# ADMIN_BOOTSTRAP_EMAILS=weimeilin@gmail.com,linchr@google.com

# Production only -- unset locally to use SQLite and local disk uploads.
# The "vibeflix" names below are the existing GCP resources. They predate the
# rename to Vibetube and cannot be renamed in place; see deploy.sh.
# DATABASE_URL=postgresql://user:password@/vibeflix?host=/cloudsql/INSTANCE
# RAW_VIDEOS_BUCKET=vibeflix-sandbox-raw-videos
# PUBLIC_STREAMS_BUCKET=vibeflix-sandbox-public-streams
# TRANSCODER_JOB_NAME=transcoder-job
# GCP_PROJECT=vibeflix-sandbox
# GCP_LOCATION=us-central1
# BACKEND_URL=https://vibetube-service-xxxx.run.app
